# Optional containers only. Copy to docker/.env and provide a local password.
POSTGRES_DB=medi_wish_container
POSTGRES_USER=medi_wish
POSTGRES_PASSWORD=
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=3001
# Browser-visible URL; rebuild frontend when this changes.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081
BACKEND_JAR=backend/target/medi-wish.jar
