# Copy values into the ignored backend/.env. Do not commit real credentials.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medi_wish_dev
DB_USERNAME=
DB_PASSWORD=
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=medi_wish_test
TEST_DB_USERNAME=
TEST_DB_PASSWORD=
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Generate a random Base64 value containing at least 32 decoded bytes.
APP_AUTH_JWT_SECRET=
# Supply a valid Argon2 verifier for the dummy password comparison path.
APP_AUTH_DUMMY_PASSWORD_VERIFIER=
# Keep true for hosted deployments; local HTTP may use false only with an explicit local/dev/development/test profile.
APP_AUTH_COOKIE_SECURE=true
